# Copy to `.env` and fill in before any deploy. `forge` loads it from the root on its own.
#
# NO PRIVATE KEY GOES IN HERE. Whoever signs is always a keystore account, passed as
# `--account <alias>`. See the "Getting started" section of the README.
#
# Every variable below is read by a script through `vm.env*`. The ones marked REQUIRED have no
# default: the script reverts before spending gas if they are missing. The ones marked OPTIONAL
# carry the default written beside them.


# --- network -----------------------------------------------------------------------------------
# Consumed by `[rpc_endpoints]` in foundry.toml, which is what `--rpc-url polygon` resolves to.

POLYGON_RPC_URL=https://polygon-rpc.com

# Not read by any script — only by the README's own commands, if you prefer exporting the alias
# to typing it. The keystore is local, so this name exists only on this machine.
# ACCOUNT_ALIAS=


# --- genesis (script/01_Deploy.s.sol) ------------------------------------------------------------
# REQUIRED. `validate()` refuses the config before it costs gas: governance may not be the zero
# address nor the deployer, and the operator may collide with neither.

GOVERNANCE=0x0000000000000000000000000000000000000000
TREASURY=0x0000000000000000000000000000000000000000
OPERATOR=0x0000000000000000000000000000000000000000

# The base currency. Must be a contract, and its `decimals()` must be 6 — the genesis rejects
# anything else. On Polygon that is USDC.
BASE_TOKEN=0x0000000000000000000000000000000000000000

# Protocol fee in basis points. Hard ceiling of 100 (1%) in `ProtocolRegistry.FEE_BPS_MAX`.
FEE_BPS=50


# --- user flow (script/user/UserFlow.s.sol) ------------------------------------------------------
# REQUIRED.

COOLDOWN=3600
MAX_VALIDITY=900
DEPOSIT_AMOUNT=1000000000

# Minimum accepted ratio, in basis points. NO DEFAULT, ON PURPOSE — zero disables this floor, and
# that has to be a decision you type rather than one the script makes for you.
#
# Read `Floors.meetsMinRatio` before choosing: it compares the **declared** `minOut` of the intent,
# never the amount the route actually returns. So it cannot stand in for the two floors that do see
# the result — `operatorMinOut`, declared by whoever submits, and `Intent.minOut`, declared by your
# strategy. On a buy your strategy's `minOut` is the only one you control, which is what
# MIN_OUT_PER_TICKET below sets for the example strategy.
#
# Zero here is a valid answer once your strategy declares its own floor. It is not a valid answer
# combined with a strategy that declares none: that leaves all three floors at zero and the vault
# accepting a route that returns nothing. Pinned in
# `test_aBuyWithEveryFloorAtZeroAcceptsAZeroFill`.
MIN_RATIO_BPS=0

# The buy floor of the example strategy: the least `ASSET` you accept for one whole TICKET of base,
# in ASSET units. A partial ticket demands a proportional share of it, rounded UP — so a floor you
# set stays a floor even on the smallest buy, instead of rounding away to zero.
#
# NO DEFAULT and zero is REFUSED by the strategy's constructor. This is the floor you control, and
# a strategy shipping without one leaves the vault accepting any fill from a route the operator
# chose. Read only when STRATEGY is unset — with your own strategy plugged in, the floor is
# whatever that strategy declares and this is ignored.
#
# The number below is an example for an 18-decimal asset. Set it from what you actually consider
# an acceptable price for a TICKET, not from this file.
MIN_OUT_PER_TICKET=1000000000000000000

# OPTIONAL.
# ASSET   — the asset the vault trades           (default: address(0))
# STRATEGY— an already deployed strategy         (default: address(0), the flow deploys the example)
# GUARD   — an already deployed guard            (default: address(0), the flow plugs none)
# TICKET  — size of each buy                     (default: 0)
# QUANTUM — minimum amount step                  (default: 0, no quantization)
# VAULT_INDEX — salt of the vault under an owner (default: 0)

ASSET=0x0000000000000000000000000000000000000000
TICKET=100000000
QUANTUM=0
VAULT_INDEX=0
# STRATEGY=
# GUARD=


# --- standalone actions (script/user/actions/*.s.sol) --------------------------------------------
# Only needed when running one action on its own instead of the whole flow.
# REQUIRED by every action: the vault it acts on.

# VAULT=

# OPTIONAL, used by 09_Withdraw.
# WITHDRAW_AMOUNT — how much leaves     (default: 0)
# WITHDRAW_TO     — who receives it     (default: msg.sender)

# WITHDRAW_AMOUNT=
# WITHDRAW_TO=
